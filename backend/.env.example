# ─── LLM API Keys ────────────────────────────────────────────────────────────
# At least one must be set for AI features to work.
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── JWT Secret ──────────────────────────────────────────────────────────────
# REQUIRED — Generate with:
#   python -c "import secrets; print(secrets.token_hex(48))"
# The server will REFUSE TO START if this is missing or uses the default value.
JWT_SECRET=

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1
