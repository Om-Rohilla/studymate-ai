# ══════════════════════════════════════════════════════════════════════════════
# StudyMate AI — Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control
# ══════════════════════════════════════════════════════════════════════════════

# ─── Supabase (Frontend — safe to expose, no privileges) ──────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Supabase (Backend — KEEP SECRET, has full DB access) ─────────────────────
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── AI Provider Keys (at least one required) ─────────────────────────────────
# Groq (free tier — primary, fastest)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini (free tier — fallback)
GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenAI (optional — used by FastAPI backend routes)
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─── Backend Auth ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_jwt_secret_minimum_32_chars_here

# ─── Environment ──────────────────────────────────────────────────────────────
ENV=production
PORT=8080
HOST=0.0.0.0

# ─── App URL (for CORS in production) ─────────────────────────────────────────
FRONTEND_URL=https://your-app-runner-url.awsapprunner.com
